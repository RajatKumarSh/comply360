# Comply360 environment variables — example only.
#
# Copy this file to .env.local and fill in the values. Never commit .env.local or real keys
# (CLAUDE.md §15, Architecture §42–43).
#
# For local development, run `npm run db:status` after `npm run db:start` and copy:
#   - "API URL"         -> NEXT_PUBLIC_SUPABASE_URL
#   - "Publishable key" -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY

# Browser-safe. Inlined into the client bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
